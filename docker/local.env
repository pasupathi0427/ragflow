# Local-only overrides for docker-compose.local.yml, passed after .env with
# --env-file. They only move host-side ports that clash on this machine;
# containers still reach each other on the default internal ports.
# 9000 and 9010 are held by the Zscaler client (ZSATunnel).
MINIO_PORT=9020
# 3306 is held by a local MySQL server.
EXPOSE_MYSQL_PORT=3307
